{
	"mcpServers": {
    "context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
					"Authorization": "Bearer {env:CONTEXT7_MCP_TOKEN_CLAUDE}"
			}
    },
    "chrome-devtools": {
			"command": "npx",
			"args": [
					"-y",
					"chrome-devtools-mcp@latest"
			]
    }
	}
}